{
  "manifest_version": 3,
  "name": "VidHawk",
  "version": "0.1.0",
  "description": "Hunts down any video, audio or file on any page — HLS, DASH, MP4, torrents — and hands it to the VidHawk engine.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "VidHawk",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ],
  "permissions": [
    "webRequest",
    "webNavigation",
    "tabs",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
