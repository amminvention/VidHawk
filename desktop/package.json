{
  "name": "vidhawk-desktop",
  "productName": "VidHawk",
  "version": "0.1.5",
  "description": "VidHawk — hunts down any video, from any player. Desktop app.",
  "main": "./out/main/index.js",
  "author": "AMM Invention",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/amminvention/VidHawk",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.9.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
